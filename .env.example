GOOGLE_API_KEY=

GEMINI_MODEL=gemini-3.6-flash

# Google OAuth app credentials (Google Cloud Console > Credentials).
# Users connect their own Gmail via "Continue with Google"; no email address here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: defaults to <host>/api/auth/callback. Must be an authorized redirect URI.
OAUTH_REDIRECT_URI=

# Optional Fernet key for encrypting stored tokens (auto-generated in tokens/ if empty).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email openid

# --- Admin panel (/admin) ---
# First super admin, created on startup only if no admin exists yet. Use a password
# (at least 8 characters), then remove it from .env. Or run:
#   python -m backend.admin.create_admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional: signing key for admin sessions (defaults to a key derived from the token encryption key)
ADMIN_SECRET_KEY=
# AI cost estimate rates, USD per 1M tokens (set to your Gemini model's real pricing)
AI_PRICE_INPUT_PER_M=0.30
AI_PRICE_OUTPUT_PER_M=2.50
# Optional: use PostgreSQL instead of the default SQLite file
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/automail
